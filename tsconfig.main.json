{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "noEmit": false,
    "outDir": "dist/main",
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "preserve",
    "moduleResolution": "node"
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist"]
}
